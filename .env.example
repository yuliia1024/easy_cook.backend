# ---------- App ----------
PORT=3100
ENV=local
# Origins of the web app (scheme://host:port, comma separated): the only ones whose requests get the
# session cookie (CORS) and may change data (Origin check). 5173: `npm run dev`, 4173: `npm run preview`.
# Production: the web app URL, e.g. https://app.example.com. `*` = any localhost, only with ENV=local.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SWAGGER_ENABLED=true
# fatal | error | warn | log | debug | verbose (default log); debug also prints every SQL query
LOG_LEVEL=debug

# ---------- Postgres (host port 5442) ----------
POSTGRES_USER=easy_cook
POSTGRES_PASSWORD=easy_cook
POSTGRES_DB=easy_cook
# Prisma reads this one; keep it in sync with the values above
DATABASE_URL=postgresql://easy_cook:easy_cook@localhost:5442/easy_cook?schema=public

# ---------- Redis (host port 6389): sessions and rate limits ----------
REDIS_PASSWORD=easy_cook_redis
# Keep in sync with REDIS_PASSWORD; outside ENV=local a password is required (rediss:// in production)
REDIS_URL=redis://:easy_cook_redis@localhost:6389/0

# ---------- Auth (Google sign-in, httpOnly session cookie) ----------
# The OAuth client id of the web app (Google Cloud console -> Credentials -> OAuth 2.0 Client IDs,
# type Web application, authorized JavaScript origins: http://localhost:5173 and the production URL)
GOOGLE_CLIENT_ID=
# Signs the CSRF tokens: at least 32 random characters, `openssl rand -base64 48`
AUTH_SECRET=
# Who may sign up (comma separated); users already in the database may always sign in
AUTH_ALLOWED_EMAILS=
# The session cookie is Secure (__Host-ec_session) unless false; false only with ENV=local, for
# browsers that refuse Secure cookies on http://localhost (Safari)
AUTH_COOKIE_SECURE=false
# strict (default) | lax | none; none only for a web app on another site (needs a Secure cookie)
AUTH_COOKIE_SAME_SITE=strict
# Proxies in front of the API whose X-Forwarded-For is trusted for the client ip (rate limits)
TRUST_PROXY_HOPS=0

# ---------- LLM providers ----------
OPEN_AI_API_KEY=
# Tried in order (openai when unset): the first serves, the next takes over on a 5xx, timeout or rate limit
MODEL_PROVIDERS=openai,deepseek
# Required when MODEL_PROVIDERS has deepseek, and for `npm run eval -- --provider deepseek`
DEEPSEEK_API_KEY=
# Required when MODEL_PROVIDERS has anthropic, and for the evals judge (Claude)
ANTHROPIC_API_KEY=

# ---------- Langfuse tracing of the model calls (off unless both keys are set) ----------
# Every call, tool loop step and tool run goes to Langfuse with its time, tokens and the request id.
# The prompts, messages, tool arguments and replies are kept with ENV=local only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud EU when unset; https://us.cloud.langfuse.com for the US region, or a self-hosted server
LANGFUSE_BASE_URL=

# ---------- Recipe search embeddings (`npm run search:index`, `npm run eval:retrieval`) ----------
# Tried in order (ollama,openai when unset): the local model first, OpenAI when it is down or not
# installed. Each model gets its own vectors. Start the local one with `npm run infra:embeddings`.
EMBEDDING_PROVIDERS=ollama,openai
OLLAMA_BASE_URL=http://localhost:11434

# ---------- e2e tests (`npm run test:e2e`) - the database is wiped and migrated on every run ----------
TEST_DATABASE_URL=postgresql://easy_cook:easy_cook@localhost:5442/easy_cook_test?schema=public
# Another Redis database than REDIS_URL: e2e tests flush it
TEST_REDIS_URL=redis://:easy_cook_redis@localhost:6389/15
