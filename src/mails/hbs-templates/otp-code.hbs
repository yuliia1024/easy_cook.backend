<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f5f5f4;font-family:Arial,Helvetica,sans-serif;color:#1c1917;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellspacing="0" cellpadding="0" style="background:#ffffff;border-radius:12px;padding:32px;">
            <tr><td style="font-size:20px;font-weight:bold;padding-bottom:16px;">Easy Cook</td></tr>
            <tr><td style="font-size:18px;padding-bottom:8px;">{{title}}</td></tr>
            <tr><td style="font-size:14px;line-height:20px;padding-bottom:24px;">{{message}}</td></tr>
            <tr>
              <td align="center" style="font-size:32px;letter-spacing:8px;font-weight:bold;background:#f5f5f4;border-radius:8px;padding:16px;">{{code}}</td>
            </tr>
            <tr><td style="font-size:12px;color:#78716c;padding-top:24px;">The code is valid for {{ttlInMinutes}} minutes. If you did not request it, just ignore this email.</td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
