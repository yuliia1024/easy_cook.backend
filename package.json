{
  "name": "easy-cook-backend",
  "version": "0.0.1",
  "description": "Easy Cook menu planner API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"evals/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint \"{src,test,scripts,evals,prisma}/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "prisma migrate deploy",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres",
    "infra:embeddings": "docker compose up -d --wait ollama",
    "infra:down": "docker compose down",
    "compose": "docker compose up --build",
    "postinstall": "prisma generate",
    "migration:create": "prisma migrate dev --create-only --name $NAME && ts-node --transpile-only scripts/strip-unmanaged-indexes.ts",
    "migration:dev": "npm run migration:create && prisma migrate deploy",
    "migration:run": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "data:classify": "ts-node --transpile-only scripts/classify-recipes.ts",
    "data:coverage": "ts-node --transpile-only scripts/recipe-coverage.ts",
    "data:import-foods": "ts-node --transpile-only scripts/import-food-data.ts",
    "data:seed-recipes": "ts-node --transpile-only scripts/seed-recipes.ts",
    "data:validate": "ts-node --transpile-only scripts/validate-seed-data.ts",
    "data:verify": "ts-node --transpile-only scripts/verify-data.ts",
    "eval": "ts-node --transpile-only evals/run.ts",
    "eval:retrieval": "ts-node --transpile-only evals/retrieval/run.ts",
    "search:index": "ts-node --transpile-only scripts/index-recipes.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/deepseek": "^3.0.89",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/provider": "^4.0.39",
    "@langfuse/core": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/vercel-ai-sdk": "^6.1.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ai": "^7.0.181",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "helmet": "^8.3.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "csv-parse": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=24.9"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "3.22.4",
    "mysql2": "^3.24.5"
  }
}
