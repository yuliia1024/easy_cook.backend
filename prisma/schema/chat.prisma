// Chat with the assistant (a stub until the LLM stage). The assistant never writes to the
// database itself: it proposes actions, the backend validates and runs them.

model Conversation {
  id                      String   @id @default(uuid()) @db.Uuid
  profileId               String   @map("profile_id") @db.Uuid
  title                   String   @db.VarChar(255)
  /// The menu the conversation is about; the last one the assistant built or the user picked.
  menuId                  String?  @map("menu_id") @db.Uuid
  /// The menu request gathered from the chat so far (`MenuRequest`): every detail the user gave,
  /// the latest message winning. Null until the first menu request. A detail the user takes back
  /// stays here: an empty value never clears one (`resolveMenuRequest`).
  menuRequest             Json?    @map("menu_request")
  /// The older messages folded into one text by the model (`ConversationSummaryService`): only
  /// what the menu request does not keep. Null until the history first outgrows its budget.
  summary                 String?
  /// The last message `summary` covers; the model reads the messages after it as they are.
  lastSummarizedMessageId String?  @map("last_summarized_message_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  menu     Menu?       @relation(fields: [menuId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([profileId, updatedAt(sort: Desc)])
  @@index([menuId])
  @@map("conversations")
}

/// Never updated.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// `MessageRole`: user | assistant
  role           String   @db.VarChar(16)
  content        String
  /// The menu version an assistant action created with this message; the menu it suggested.
  menuVersionId  String?  @map("menu_version_id") @db.Uuid
  /// The change of the dietary preferences the assistant proposed with this reply
  /// (`PreferenceChange`); applied only once the user confirms it, while it is the latest reply.
  preferenceChange Json? @map("preference_change")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  menuVersion  MenuVersion? @relation(fields: [menuVersionId], references: [id], onDelete: SetNull)
  toolCalls    MessageToolCall[]

  @@index([conversationId, createdAt])
  @@index([menuVersionId])
  @@map("messages")
}

/// A step the chat model took for an assistant reply: a tool it called, with the arguments as it
/// sent them and what it got back. Saved with the reply; never updated.
model MessageToolCall {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  /// The order of the call in the reply, from 0.
  position   Int
  /// `ChatToolName`
  toolName   String   @map("tool_name") @db.VarChar(64)
  input      Json
  /// The result, or the `ChatToolError` the model got.
  output     Json
  /// `ChatToolErrorCode`; null when the tool succeeded.
  error      String?  @db.VarChar(32)
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@map("message_tool_calls")
}
