{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>/src", "<rootDir>/scripts", "<rootDir>/evals"],
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["reflect-metadata"],
  "clearMocks": true,
  "restoreMocks": true,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "scripts/lib/**/*.ts",
    "evals/lib/**/*.ts",
    "evals/suites/**/*.ts",
    "!src/main.ts",
    "!**/index.ts",
    "!**/*.module.ts",
    "!src/test/**"
  ],
  "coverageDirectory": "./coverage"
}
