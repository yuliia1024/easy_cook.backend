# ---------- App ----------
PORT=3100
ENV=local
CORS_ORIGINS=*
SWAGGER_ENABLED=true
FRONT_END_URL=http://localhost:5173

# ---------- Postgres (host port 5442, separate from clearwire's 5432/5433) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_USER=easy_cook
POSTGRES_PASSWORD=easy_cook
POSTGRES_DB=easy_cook
POSTGRES_LOGGING=false

# ---------- Redis (host port 6390, separate from clearwire's 6379/6380) ----------
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT (tokens are also stored in Redis; a token missing there is rejected) ----------
AUTH_JWT_SECRET=change-me
AUTH_JWT_EXPIRES_IN_SEC=900
AUTH_JWT_REFRESH_SECRET=change-me-too
AUTH_JWT_REFRESH_EXPIRES_IN_SEC=2592000

PASSWORD_HASH_SALT=12

# ---------- OTP (email confirmation codes) ----------
OTP_LENGTH=6
OTP_TTL_IN_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_IN_SEC=60

# ---------- SMTP / Nodemailer (local: Mailpit, UI on http://localhost:8035) ----------
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="Easy Cook <no-reply@easycook.local>"
