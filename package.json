{
  "name": "easy-cook-backend",
  "version": "0.0.1",
  "description": "Easy Cook monolith API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres redis mailpit",
    "infra:down": "docker compose down",
    "compose": "docker compose up --build",
    "migration:generate": "npm run build && node ./node_modules/.bin/typeorm -d ./dist/database/ormconfig.js migration:generate ./src/database/migrations/$NAME && npm run format",
    "migration:create": "./node_modules/.bin/typeorm migration:create src/database/migrations/$NAME",
    "migration:run": "npm run build && node ./node_modules/.bin/typeorm -d ./dist/database/ormconfig.js migration:run",
    "migration:revert": "npm run build && node ./node_modules/.bin/typeorm -d ./dist/database/ormconfig.js migration:revert",
    "migration:show": "npm run build && node ./node_modules/.bin/typeorm -d ./dist/database/ormconfig.js migration:show",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "clearMocks": true,
    "restoreMocks": true,
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!**/index.ts",
      "!database/**",
      "!**/*.module.ts",
      "!test/**"
    ],
    "coverageDirectory": "../coverage"
  }
}
